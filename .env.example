# Copy this file to .env and fill in real values. .env is gitignored.
POSTGRES_USER=companion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=companion

RABBITMQ_USER=companion
RABBITMQ_PASSWORD=change-me

# Optional host-port overrides for RabbitMQ (defaults: 5672 / 15672).
# Useful when another local RabbitMQ already owns the default ports.
#RABBITMQ_PORT=5673
#RABBITMQ_MANAGEMENT_PORT=15673

# For the opt-in Compose app profile. Fill the API database connection string
# with host postgres and the PostgreSQL credentials above. The JWT key and OTP
# pepper are separate base64-encoded secrets, each at least 32 bytes decoded.
#COMPANION_API_DB=
#COMPANION_EXTRACTION_DB=
#COMPANION_JWT_SIGNING_KEY=
#COMPANION_OTP_PEPPER=
#COMPANION_API_PORT=8080
#POSTGRES_PORT=5432
