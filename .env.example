# Copy this file to .env and fill in real values. .env is gitignored.
POSTGRES_USER=companion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=companion

RABBITMQ_USER=companion
RABBITMQ_PASSWORD=change-me

# Optional host-port overrides for RabbitMQ (defaults: 5672 / 15672).
# Useful when another local RabbitMQ already owns the default ports.
#RABBITMQ_PORT=5673
#RABBITMQ_MANAGEMENT_PORT=15673
