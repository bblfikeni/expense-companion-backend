{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Extraction": {
    "Enabled": false,
    // One deadline per delivery. Maximum 268s leaves time for cleanup below half the 540s recovery lease.
    "MessageTimeoutSeconds": 120,
    "OcrExecutablePath": "tesseract",
    "OcrPageSegmentationMode": 6,
    "OcrTimeoutSeconds": 30,
    "OcrMaxConcurrency": 2,
    "MaxRetries": 3,
    "RetryBackoffBaseSeconds": 30,
    "MaxImagesPerExpense": 10,
    "VatToleranceCents": 5,
    "AutoQualifyThreshold": 0.85,
    "NeedsReviewThreshold": 0.60,
    "CriticalFieldMinimum": 0.50
  }
}
