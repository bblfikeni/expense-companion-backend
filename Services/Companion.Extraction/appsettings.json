{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Extraction": {
    "Enabled": false,
    "MessageTimeoutSeconds": 120,
    "MaxRetries": 3,
    "RetryBackoffBaseSeconds": 30,
    "MaxImagesPerExpense": 10,
    "VatToleranceCents": 5,
    "AutoQualifyThreshold": 0.85,
    "NeedsReviewThreshold": 0.60,
    "CriticalFieldMinimum": 0.50
  }
}
